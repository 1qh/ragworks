{
  "name": "ragworks",
  "version": "0.0.34",
  "description": "The RAG engine minus the store: multi-engine document understanding with per-page routing, chunking, provenance that survives chunking, embedding, and retrieval logic.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1qh/ragworks.git"
  },
  "license": "Apache-2.0",
  "author": "1qh",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./bridge": {
      "types": "./dist/bridge.d.mts",
      "default": "./dist/bridge.mjs"
    },
    "./digital": {
      "types": "./dist/digital.d.mts",
      "default": "./dist/digital.mjs"
    },
    "./embed-cache": {
      "types": "./dist/embed-cache.d.mts",
      "default": "./dist/embed-cache.mjs"
    },
    "./geometry": {
      "types": "./dist/geometry.d.mts",
      "default": "./dist/geometry.mjs"
    },
    "./models": {
      "types": "./dist/models.d.mts",
      "default": "./dist/models.mjs"
    },
    "./office-render": {
      "types": "./dist/office-render.d.mts",
      "default": "./dist/office-render.mjs"
    },
    "./opensearch": {
      "types": "./dist/opensearch.d.mts",
      "default": "./dist/opensearch.mjs"
    },
    "./region": {
      "types": "./dist/region.d.mts",
      "default": "./dist/region.mjs"
    },
    "./vlm": {
      "types": "./dist/vlm.d.mts",
      "default": "./dist/vlm.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "bun run build",
    "postpublish": "bun ../../tools/prune-versions.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "latest",
    "@docling/docling-core": "latest",
    "@flatten-js/interval-tree": "latest",
    "@mastra/rag": "latest",
    "@opensearch-project/opensearch": "latest",
    "@opentelemetry/api": "latest",
    "@opentelemetry/exporter-trace-otlp-http": "latest",
    "@opentelemetry/resources": "latest",
    "@opentelemetry/sdk-trace-base": "latest",
    "@opentelemetry/semantic-conventions": "latest",
    "ai": "latest",
    "cockatiel": "latest",
    "exceljs": "latest",
    "fractional-indexing": "latest",
    "google-auth-library": "latest",
    "mupdf": "latest",
    "node-html-parser": "latest",
    "pino": "latest",
    "smol-toml": "latest",
    "zod": "latest"
  }
}
